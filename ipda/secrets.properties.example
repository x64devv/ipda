# cTrader Open API credentials — copy to secrets.properties (gitignored) and fill in.
# clientId / clientSecret: openapi.ctrader.com -> your application
# accessToken: application page -> Playground/Sandbox -> choose scope -> Get token
#   ("accounts" scope is sufficient for historical data; "trading" needed later for orders)
clientId=CHANGE_ME
clientSecret=CHANGE_ME
accessToken=CHANGE_ME
# refreshToken=optional
# accountId=optional explicit ctidTraderAccountId (defaults to first demo account on the token)
# host=demo.ctraderapi.com
